{
  "name": "forge",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Local-first life direction, execution, and reflection system for Forge.",
  "openclaw": {
    "extensions": [
      "./apps/web/src/openclaw/index.legacy.ts"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:openclaw-data": "node ./scripts/dev/with-openclaw-plugin-data-root.mjs npm run dev",
    "dev:openclaw-plugin-runtime": "FORGE_OPENCLAW_DEV=1 node ./plugins/openclaw/server/index.js",
    "dev:web": "FORGE_BASE_PATH=/forge/ vite --host 0.0.0.0",
    "dev:server": "node ./scripts/dev/with-monorepo-data-root.mjs env FORGE_DEV_WEB_ORIGIN=http://127.0.0.1:3027/forge/ HOST=0.0.0.0 PORT=4317 tsx watch apps/api/src/index.ts",
    "dev:server:openclaw-data": "node ./scripts/dev/with-openclaw-plugin-data-root.mjs npm run dev:server",
    "demo:seed": "node ./scripts/dev/with-monorepo-data-root.mjs node --import tsx apps/api/src/seed-demo.ts",
    "demo:seed:openclaw-data": "node ./scripts/dev/with-openclaw-plugin-data-root.mjs npm run demo:seed",
    "doctor": "node --import tsx scripts/dev/forge-doctor.ts",
    "docs:openapi": "node --import tsx scripts/docs/export-openapi-docs.ts",
    "icons:generate": "node ./scripts/assets/generate-app-icons.mjs",
    "cropper:gamification": "node scripts/assets/serve-atlas-cropper.mjs",
    "smoke:published-openclaw-plugin": "bash ./scripts/smoke/smoke-test-published-openclaw-plugin.sh",
    "smoke:packed-openclaw-runtime": "node ./scripts/smoke/smoke-test-packed-openclaw-runtime.mjs",
    "start": "npm run build && npm run start:web",
    "start:openclaw-data": "node ./scripts/dev/with-openclaw-plugin-data-root.mjs npm run start",
    "start:web": "node ./scripts/dev/with-monorepo-data-root.mjs env HOST=0.0.0.0 PORT=4317 tsx apps/api/src/index.ts",
    "tauri:dev": "tauri dev --config apps/desktop-tauri/tauri.conf.json",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:server": "tsc -p apps/api/tsconfig.json --noEmit",
    "check:gamification-assets": "node --import tsx scripts/assets/validate-gamification-assets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:server": "node --import tsx --test --test-concurrency=1 apps/api/src/*.test.ts",
    "build:openclaw-plugin": "npm --prefix plugins/openclaw run build",
    "test:forge-memory": "npm --prefix packages/forge-memory test",
    "pack:forge-memory": "cd packages/forge-memory && npm pack",
    "verify:connectivity-service": "npm --prefix packages/forge-connectivity-service run verify",
    "audit:connectivity-service": "npm --prefix packages/forge-connectivity-service run audit",
    "pack:connectivity-service": "cd packages/forge-connectivity-service && npm pack",
    "release:ios-companion:audit": "bash ./apps/ios-companion/scripts/publish-forge-companion.sh audit",
    "release:ios-companion:validate": "bash ./apps/ios-companion/scripts/publish-forge-companion.sh validate",
    "release:ios-companion:testflight": "bash ./apps/ios-companion/scripts/publish-forge-companion.sh testflight",
    "release:ios-companion:app-store": "bash ./apps/ios-companion/scripts/publish-forge-companion.sh app-store",
    "media:ios-companion:screenshots": "bash ./apps/ios-companion/scripts/capture-forge-companion-media.sh",
    "media:docs-ios": "node ./scripts/docs/generate-docs-ios-media.mjs",
    "measure:watchos": "bash ./apps/ios-companion/scripts/measure-forge-watch-usability.sh",
    "media:web:docs-fixture": "node --import tsx ./scripts/docs/prepare-web-docs-screenshot-data.ts",
    "media:web:docs-screenshots": "node ./scripts/docs/capture-web-docs-screenshots.mjs",
    "check:openclaw-plugin": "npm exec -- vitest run apps/web/src/openclaw/parity.test.ts apps/web/src/openclaw/index.test.ts apps/web/src/openclaw/api-client.test.ts apps/web/src/openclaw/manifest.test.ts",
    "check:people-sharing-release": "node ./scripts/ci/check-people-sharing-release.mjs",
    "check:people-sharing-migration-parity": "node ./scripts/ci/check-people-sharing-migration-parity.mjs",
    "test:people-sharing": "node ./scripts/ci/run-people-sharing-tests.mjs",
    "test:people-performance": "node --test ./scripts/perf/people-performance.test.mjs",
    "check:people-performance": "node ./scripts/perf/people-performance.mjs --mode release",
    "test:people-upgrade-restore": "node --test ./scripts/ci/check-people-upgrade-restore.test.mjs",
    "check:people-upgrade-restore": "node ./scripts/ci/check-people-upgrade-restore.mjs --mode release",
    "test:people-packed-surfaces": "node --test ./scripts/smoke/people-packed-surfaces.test.mjs",
    "test:people-sharing-release-fast": "node --test ./scripts/ci/check-people-sharing-release.test.mjs ./scripts/ci/check-people-sharing-migration-parity.test.mjs",
    "test:people-sharing-release-gate": "node --test ./scripts/ci/check-people-sharing-release.test.mjs ./scripts/ci/check-people-sharing-migration-parity.test.mjs ./scripts/ci/check-people-upgrade-restore.test.mjs ./scripts/smoke/people-packed-surfaces.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@azure/msal-node": "^5.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hookform/resolvers": "^5.1.1",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@reduxjs/toolkit": "^2.11.2",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@sinclair/typebox": "^0.34.49",
    "@tanstack/react-query": "^5.80.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tiptap/react": "^2.15.0",
    "@tiptap/starter-kit": "^2.15.0",
    "@types/react-grid-layout": "^1.3.6",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.6.0",
    "bonjour-service": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "fast-xml-parser": "^5.5.9",
    "fastify": "^5.8.5",
    "framer-motion": "^12.16.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "^5.24.0",
    "node-ical": "^0.26.1",
    "openclaw": "2026.6.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.57.0",
    "react-is": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.1.0",
    "sigma": "^3.0.2",
    "tailwind-merge": "^3.3.1",
    "tsdav": "^2.1.8",
    "zod": "^3.25.67",
    "zod-to-json-schema": "3.25.2",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "axios": "^1.16.0",
    "follow-redirects": "^1.16.0",
    "hono": "4.12.30",
    "ip-address": "^10.2.0",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "yaml": "^2.8.1"
  }
}
